{
  "name": "copper-cloud-portal",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_MOCK=1 next dev",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "next build && touch out/.gitkeep",
    "build:mock": "NEXT_PUBLIC_MOCK=1 next build && touch out/.gitkeep",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0"
  },
  "description": "Admin portal for copper-cloud (static export embedded in the server binary)"
}
